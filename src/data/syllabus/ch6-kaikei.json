            "r03-14",
            "r04-14",
            "r05-11",
            "r06-10",
            "r07-10"
          ]
        },
        {
          "t": "**負債**：未払金・前受金・預り金（返す義務がある）・仮受金",
          "q": [
            "r03-14",
            "r04-14",
            "r05-11",
            "r06-10",
            "r07-10"
          ]
        },
        {
          "t": "次期繰越金は**繰越金の部**に計上する",
          "q": [
            "r04-14"
          ]
        }
      ]
    },
    {
