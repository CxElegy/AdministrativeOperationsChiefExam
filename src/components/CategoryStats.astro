---
/** ノートのページに「この分野の出題数（年度別）」と演習へのリンクを出す */
import { categoryLabel } from '../data/categories';
import { getExams, url } from '../lib/data';

interface Props {
	category: string;
}
const { category } = Astro.props;
const exams = await getExams();
const rows = exams.map((e) => ({
	label: e.label,
	nos: e.questions.filter((q) => q.category === category).map((q) => q.no),
	id: e.id,
}));
const total = rows.reduce((n, r) => n + r.nos.length, 0);
---

<div class="kk-catstats">
	<p>
		収録している過去問のうち「{categoryLabel(category)}」は <strong>{total}</strong> 問。
		<a href={url(`/practice/?cat=${category}`)}>この分野だけを演習する →</a>
	</p>
	<table>
		<thead><tr><th>年度</th><th>問数</th><th>問題番号</th></tr></thead>
		<tbody>
			{
				rows.map((r) => (
					<tr>
						<td><a href={url(`/kakomon/${r.id}/`)}>{r.label}</a></td>
						<td>{r.nos.length}</td>
						<td>{r.nos.map((n) => `問${n}`).join('、')}</td>
					</tr>
				))
			}
		</tbody>
	</table>
	<p class="kk-note">分野は問題文の言葉から自動で振り分けています。複数の分野にまたがる問題もあります。</p>
</div>
