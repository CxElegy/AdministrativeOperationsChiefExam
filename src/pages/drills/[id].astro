---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import QuizData from '../../components/QuizData.astro';
import { drillItems, getDrills, url } from '../../lib/data';

export async function getStaticPaths() {
	const drills = await getDrills();
	return drills.map((drill) => ({ params: { id: drill.id }, props: { drill } }));
}
const { drill } = Astro.props;
---

<StarlightPage frontmatter={{ title: drill.title, description: drill.description, tableOfContents: false }}>
	{drill.description && <p>{drill.description}</p>}
	<p><label><input type="checkbox" data-shuffle /> ランダムな順番で出題</label></p>
	<div class="qz not-content" data-quiz></div>
	<QuizData id="quiz-data" items={drillItems(drill)} />
	<p class="kk-note"><a href={url('/drills/')}>← ドリル一覧へ</a></p>
</StarlightPage>

<script>
	import { QuizApp, shuffle } from '../../lib/quiz';
	import type { QuizItem } from '../../lib/types';

	const root = document.querySelector<HTMLElement>('[data-quiz]')!;
	const all: QuizItem[] = JSON.parse(document.getElementById('quiz-data')!.textContent!);
	const box = document.querySelector<HTMLInputElement>('[data-shuffle]')!;
	const start = () => new QuizApp(root, box.checked ? shuffle(all) : all, { mode: 'practice' });
	box.addEventListener('change', start);
	start();
</script>
