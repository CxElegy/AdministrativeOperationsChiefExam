---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import QuizData from '../../components/QuizData.astro';
import { examItems, getExams, url } from '../../lib/data';

export async function getStaticPaths() {
	const exams = await getExams();
	return exams.map((exam) => ({ params: { id: exam.id }, props: { exam } }));
}

const { exam } = Astro.props;
const items = examItems(exam);
---

<StarlightPage
	frontmatter={{ title: `${exam.label} 過去問`, description: `管理業務主任者試験 ${exam.label}の過去問 50問`, tableOfContents: false }}
>
	<p class="kk-lead">
		合格基準点 {exam.passMark ?? '—'} 問（5問免除者は {exam.passMarkExempt ?? '—'} 問）・<a href={exam.sourceUrl} target="_blank" rel="noopener"
			>問題 PDF（公式）</a
		>
	</p>
	<form class="kk-modes" data-modes>
		<label><input type="radio" name="mode" value="practice" checked /> 練習モード（1問ごとに正解表示）</label>
		<label><input type="radio" name="mode" value="exam" /> 本番モード（2時間・最後に採点）</label>
		<label><input type="checkbox" name="exempt" /> 5問免除（問46〜50を除く45問）</label>
		<button type="submit" class="qz-btn qz-primary">はじめる</button>
	</form>
	<div class="qz not-content" data-quiz data-pass={exam.passMark ?? ''} data-pass-exempt={exam.passMarkExempt ?? ''}></div>
	<QuizData id="quiz-data" items={items} />
	<p class="kk-note"><a href={url('/kakomon/')}>← 年度一覧へ</a></p>
</StarlightPage>

<script>
	import { QuizApp } from '../../lib/quiz';
	import type { QuizItem } from '../../lib/types';

	const root = document.querySelector<HTMLElement>('[data-quiz]')!;
	const all: QuizItem[] = JSON.parse(document.getElementById('quiz-data')!.textContent!);
	const form = document.querySelector<HTMLFormElement>('[data-modes]')!;

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const fd = new FormData(form);
		const exam = fd.get('mode') === 'exam';
		const exempt = fd.get('exempt') === 'on';
		const items = exempt ? all.filter((q) => q.no <= 45) : all;
		const pass = Number(exempt ? root.dataset.passExempt : root.dataset.pass) || null;
		new QuizApp(root, items, {
			mode: exam ? 'exam' : 'practice',
			timeLimit: exam ? (exempt ? 110 : 120) : undefined,
			passMark: pass,
		});
		root.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
	new QuizApp(root, all, { mode: 'practice', passMark: Number(root.dataset.pass) || null });
</script>
