---
import { getCollection } from 'astro:content';
import Guide from '../../layouts/Guide.astro';

const pages = (await getCollection('guide')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const top = pages.filter((p) => !p.id.startsWith('notes/'));
const notes = pages.filter((p) => p.id.startsWith('notes/'));
---

<Guide title="ガイド・ノート">
	<h1>ガイド・ノート</h1>
	<h2>試験と使い方</h2>
	<ul class="link-cards">
		{top.map((p) => <li><a href={`${base}guide/${p.id}/`}><b>{p.data.title}</b><span>{p.data.description}</span></a></li>)}
	</ul>
	<h2>分野別ノート（各階の予習）</h2>
	<ul class="link-cards">
		{notes.map((p) => <li><a href={`${base}guide/${p.id}/`}><b>{p.data.title}</b><span>{p.data.description}</span></a></li>)}
	</ul>
</Guide>
