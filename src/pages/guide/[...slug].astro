---
import { getCollection, render } from 'astro:content';
import Guide from '../../layouts/Guide.astro';
import { CATEGORIES } from '../../data/categories';
import { getAppData } from '../../lib/build-data';

export async function getStaticPaths() {
	const pages = await getCollection('guide');
	return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
const { Content } = await render(page);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// ノートのページには、その階の部屋と過去の出題を出す
let floor = null;
if (page.data.category) {
	const data = await getAppData();
	const f = data.floors.find((x) => x.id === page.data.category);
	if (f) {
		floor = {
			...f,
			label: CATEGORIES.find((c) => c.id === f.id)?.label,
			rooms: f.rooms.map((r) => ({ ...r, refs: r.qids.map((id) => data.questions[id]).map((q) => `${q.set.replace('度', '')} 問${q.no}`) })),
		};
	}
}
---

<Guide title={page.data.title} description={page.data.description}>
	<h1>{page.data.title}</h1>
	<Content />
	{
		floor && (
			<section class="floor-rooms">
				<h2>{floor.floor}F の部屋（{floor.rooms.length}室）</h2>
				<p>ノートを読んだら、部屋の相談（過去問）に答えて確認しよう。</p>
				<ul>
					{floor.rooms.map((r) => (
						<li>
							<a href={`${base}#/room/${r.id}`}>{r.no}号室</a>
							<span>{r.refs.join('、')}</span>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Guide>
