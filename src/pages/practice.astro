---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import QuizData from '../components/QuizData.astro';
import { CATEGORIES } from '../data/categories';
import { examItems, getExams } from '../lib/data';

const exams = await getExams();
const items = exams.flatMap(examItems);
const countByCat = Object.fromEntries(CATEGORIES.map((c) => [c.id, items.filter((i) => i.category === c.id).length]));
---

<StarlightPage frontmatter={{ title: '分野別・ランダム演習', description: '過去問を分野・年度で絞り込んで演習する', tableOfContents: false }}>
	<p>分野と年度を選んで出題します。「間違えた問題」「まだ解いていない問題」は、このブラウザに保存された学習記録をもとに絞り込みます。</p>
	<form class="kk-filter" data-filter>
		<fieldset>
			<legend>分野</legend>
			{
				CATEGORIES.map((c) => (
					<label>
						<input type="checkbox" name="cat" value={c.id} checked /> {c.label}（{countByCat[c.id]}）
					</label>
				))
			}
		</fieldset>
		<fieldset>
			<legend>年度</legend>
			{
				exams.map((e) => (
					<label>
						<input type="checkbox" name="set" value={e.label} checked /> {e.label}
					</label>
				))
			}
		</fieldset>
		<fieldset>
			<legend>出題</legend>
			<label><input type="radio" name="pool" value="all" checked /> すべて</label>
			<label><input type="radio" name="pool" value="wrong" /> 前回間違えた問題</label>
			<label><input type="radio" name="pool" value="new" /> まだ解いていない問題</label>
			<label>
				出題数
				<select name="count">
					<option value="10">10問</option>
					<option value="20" selected>20問</option>
					<option value="50">50問</option>
					<option value="0">すべて</option>
				</select>
			</label>
			<label><input type="checkbox" name="shuffle" checked /> ランダムな順番</label>
		</fieldset>
		<p class="kk-actions">
			<button type="submit" class="qz-btn qz-primary">はじめる</button>
			<span data-count></span>
		</p>
	</form>
	<div class="qz not-content" data-quiz></div>
	<QuizData id="quiz-data" items={items} />
</StarlightPage>

<script>
	import { QuizApp, shuffle } from '../lib/quiz';
	import { loadRecord } from '../lib/record';
	import type { QuizItem } from '../lib/types';

	const all: QuizItem[] = JSON.parse(document.getElementById('quiz-data')!.textContent!);
	const form = document.querySelector<HTMLFormElement>('[data-filter]')!;
	const root = document.querySelector<HTMLElement>('[data-quiz]')!;
	const countEl = form.querySelector<HTMLElement>('[data-count]')!;

	// ?cat=minpo のように URL で分野を指定できる（ノートからのリンク用）
	const preset = new URLSearchParams(location.search).get('cat');
	if (preset) {
		form.querySelectorAll<HTMLInputElement>('input[name=cat]').forEach((el) => (el.checked = el.value === preset));
	}

	function pick() {
		const fd = new FormData(form);
		const cats = new Set(fd.getAll('cat'));
		const sets = new Set(fd.getAll('set'));
		const pool = fd.get('pool');
		const rec = loadRecord();
		let list = all.filter((q) => cats.has(q.category) && sets.has(q.set));
		if (pool === 'wrong') list = list.filter((q) => rec[q.id] && !rec[q.id].last);
		if (pool === 'new') list = list.filter((q) => !rec[q.id]);
		return list;
	}

	function updateCount() {
		countEl.textContent = `対象 ${pick().length} 問`;
	}
	form.addEventListener('change', updateCount);
	updateCount();

	form.addEventListener('submit', (e) => {
		e.preventDefault();
		const fd = new FormData(form);
		let list = pick();
		if (fd.get('shuffle') === 'on') list = shuffle(list);
		const n = Number(fd.get('count'));
		if (n > 0) list = list.slice(0, n);
		new QuizApp(root, list, { mode: 'practice' });
		root.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
</script>
