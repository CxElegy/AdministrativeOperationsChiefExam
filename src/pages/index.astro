---
import Base from '../layouts/Base.astro';
import { getAppData } from '../lib/build-data';

const data = await getAppData();
---

<Base>
	<div class="app" data-app>
		<section class="stage" data-stage aria-label="マンションの攻略状況"></section>
		<main class="panel" data-panel>
			<noscript><p class="card">このサイトは JavaScript を使います。ブラウザの設定で JavaScript を有効にしてください。</p></noscript>
		</main>
	</div>
	<script type="application/json" id="app-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
</Base>

<script>
	import { App } from '../lib/app';
	import type { AppData } from '../lib/types';

	const data: AppData = JSON.parse(document.getElementById('app-data')!.textContent!);
	new App(document.querySelector<HTMLElement>('[data-app]')!, data);
</script>
